# Pooled Postgres connection string.
#   Neon (via Vercel marketplace): use the host ending in -pooler
#   Supabase: Connection pooling > Transaction, port 6543
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Any random string. Salts the hash used to rate-limit one sender, so the
# table never holds a raw IP address.
SENDER_SALT=change-me-to-something-random

# Your site's absolute origin, no trailing slash. Baked into the link-preview
# (Open Graph) tags at build time: WhatsApp will not resolve a relative image,
# so without it a shared link shows a grey box.
VITE_SITE_URL=https://nama-undangan-kamu.vercel.app
